# Sioyek User Preferences
# See: https://sioyek-documentation.readthedocs.io/

# Editor for inverse search (SyncTeX: PDF → source). Headless nvim hands the
# jump to the running nvim, so no terminal is needed. GUI apps on macOS do not
# inherit the shell $PATH, hence env with Homebrew's bin first.
inverse_search_command /usr/bin/env PATH=/opt/homebrew/bin:/usr/bin:/bin nvim --headless -c "VimtexInverseSearch %2 '%1'"

# Or for GUI nvim:
# inverse_search_command neovide --remote-send "<C-\><C-n>:e %1<CR>:%2<CR>"

# Or simple nvim (opens new instance):
# inverse_search_command kitty nvim +%2 %1

# UI preferences
default_dark_mode 1

# Performance
should_load_tutorial_when_no_other_file 0
