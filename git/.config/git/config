	email = sofia.fernandezlozano@mail.mcgill.ca
[core]
	editor = nvim
	pager = delta
	excludesFile = ~/.local/state/git/ignore
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
[merge]
    conflictstyle = zdiff3
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[url "git@github.com:"]
	# Push to GitHub over SSH even when the remote was cloned over HTTPS
	pushInsteadOf = https://github.com/
[include]
	# Machine-local overrides (work email, etc). Ignored if absent.
	path = config.local
