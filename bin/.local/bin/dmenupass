#!/usr/bin/env bash

shopt -s nullglob globstar

typeit=0
if [[ $1 == "--type" ]]; then
	typeit=1
	shift
fi


STARTDIR=${PASSWORD_STORE_DIR-~/.password-store}
BASEDIR=$STARTDIR
DONE=0
LEVEL=0
PREVSELECTION=""
SELECTION=""

while [ "$DONE" -eq 0 ] ; do
  password_files=( "$STARTDIR"/* )
  password_files=( "${password_files[@]#"$STARTDIR"/}" )
  password_files=( "${password_files[@]%.gpg}" )

  if [ "$LEVEL" -ne 0 ] ; then
    password_files=(".." "${password_files[@]}")
  fi
  entry=$(printf '%s\n' "${password_files[@]}" | dmenu "$@" -l 15)

  if [ -z "$entry" ] ; then
    DONE=1
    exit
  fi

  if [ "$entry" != ".." ] ; then
    PREVSELECTION=$SELECTION
    SELECTION="$SELECTION/$entry"

    # check if another dir
    if [ -d "$STARTDIR/$entry" ] ; then
      STARTDIR="$STARTDIR/$entry"
      LEVEL=$((LEVEL+1))
    else
      # not a directory so it must be a real password entry

      if [[ $typeit -eq 0 ]]; then
        # Pause clipmenud so the password never lands in the clip history.
        clipctl disable 2>/dev/null
        if pass show -c "$SELECTION" 2>/dev/null; then
          notify-send "pass" "Password copied to clipboard; will clear in ${PASSWORD_STORE_CLIP_TIME:-45}s."
        else
          notify-send "pass" "failed"
        fi
        ( sleep "${PASSWORD_STORE_CLIP_TIME:-45}"; clipctl enable ) >/dev/null 2>&1 &
      else
        win=$(xdotool getactivewindow)
        pass show "$SELECTION" | head -n1 | tr -d '\n' |
          xdotool type --window "$win" --delay 20 --file -
      fi
      DONE=1
    fi

  else
    LEVEL=$((LEVEL-1))
    SELECTION=$PREVSELECTION
    STARTDIR="$BASEDIR/$SELECTION"
  fi
done

