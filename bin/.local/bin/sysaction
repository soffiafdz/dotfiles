#!/bin/sh

# A dmenu wrapper script for system functions.

# For non-systemd init systems.
case "$(readlink -f /sbin/init)" in
*runit*)
  hib="sudo -A zzz"
  reb="sudo -A reboot"
  shut="sudo -A poweroff"
  ;;
*openrc*)
  reb="sudo -A openrc-shutdown -r"
  shut="sudo -A openrc-shutdown -p 0"
  ;;
esac

cmds="\
  display off	displayoff
 lock	slock
󰠚 leave DWM	kill -TERM $(pgrep -u "$USER" -x dwm)
⏾ sleep	${hib:-systemctl suspend-then-hibernate -i}
 reboot	${reb:-sudo -A reboot}
 shutdown	${shut:-sudo -A shutdown -h now}"

die() {
  if command -v notify-send >/dev/null; then
    notify-send -u critical "sysaction" "$1"
  else
    echo "sysaction: $1" >&2
  fi
  exit 1
}

# dmenu wrapper: a cancel (Escape) exits quietly, but anything dmenu writes to
# stderr is a real failure (bad flag, no font, no display) and must be visible
# instead of silently aborting the action.
menu() {
  _err="$(mktemp)" || die "mktemp failed"
  _out="$(dmenu "$@" 2>"$_err")"
  _status=$?
  if [ -s "$_err" ]; then
    _msg="$(head -n 2 "$_err")"
    rm -f "$_err"
    die "dmenu failed: $_msg"
  fi
  rm -f "$_err"
  [ "$_status" -eq 0 ] || exit 1
  printf '%s\n' "$_out"
}

choice="$(echo "$cmds" | cut -d'	' -f 1 | menu)" || exit 1
[ -z "$choice" ] && exit 1

cmd="$(echo "$cmds" | grep -F -- "$choice	" | cut -d '	' -f2-)"
[ -z "$cmd" ] && die "no command for '$choice'"

case "$choice" in
*lock)
  command -v slock >/dev/null || die "slock is not installed"
  ;;
*leave* | *sleep | *reboot | *shutdown)
  [ "$(printf 'No\nYes' | menu -p "$choice?")" = "Yes" ] || exit 1
  ;;
esac

exec sh -c "$cmd"
