#!/bin/sh
# SUDO_ASKPASS helper. Arg: prompt. Output: password on stdout.
# Exits non-zero on cancel/error so sudo aborts without registering a PAM failure.
prompt="${1:-Sudo password required}"
pinentry="$(dirname "$0")/pinentry-auto"
[ -x "$pinentry" ] || pinentry=pinentry-auto
out=$({
	printf 'SETTITLE sudo\n'
	printf 'SETDESC %s\n' "$prompt"
	printf 'SETPROMPT Password:\n'
	printf 'GETPIN\n'
} | "$pinentry" 2>/dev/null)
printf '%s\n' "$out" | grep -q '^ERR ' && exit 1
# Decode Assuan percent escapes (%25, %0A, ...) in the D line.
pin=$(printf '%b' "$(printf '%s\n' "$out" | sed -n 's/^D //p' | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')")
[ -z "$pin" ] && exit 1
printf '%s\n' "$pin"
