#!/bin/sh

# Use $XINITRC
[ -f "$XINITRC" ] && alias startx='startx "$XINITRC"'

if [ "$(uname -s)" = "Darwin" ]; then
  # macOS-specific aliases (every Mac, not just one hostname)
  alias xdg-open="open"
  alias xclip="pbcopy"
  alias xsel="pbcopy"
  alias brewup="brew update && brew upgrade && brew cleanup"
else
  case "$(uname -n)" in
  Lazarus)
    # alias nvim="~/.local/bin/nvim-linux-x86_64/bin/nvim"
    alias bat="batcat"
    ;;
  Calliope)
    alias bat="batcat"
    ;;
  *mcgill*)
    alias \
      _tmux="init_tmux" \
      _mamba=". /export02/data/sfernand/mamba/etc/profile.d/conda.sh" \
      _conda=". /ipl/quarantine/conda/etc/profile.d/conda.sh"
    ;;
  *)
    # Abbreviations
    alias \
      trem="transmission-remote" \
      p="sudo pacman"
    # Implicit sudo in most used commands
    for bin in mount umount sv pacman su light; do
      alias "$bin"="sudo $bin"
    done
    ;;
  esac
fi

# Use neovim (if installed) rather than vim
[ -x "$(command -v nvim)" ] && alias vim="nvim" vimdiff="nvim -d"

# Radian
alias r="radian"

# eza / exa / ls
if command -v eza >/dev/null 2>&1; then
  alias \
    ls='eza --color=auto --icons=auto' \
    ll='eza -lA --color=auto --icons=auto' \
    la='eza -A --color=auto --icons=auto' \
    l='eza -F --color=auto --icons=auto'
elif command -v exa >/dev/null 2>&1; then
  alias \
    ls="exa --group-directories-first" \
    la="exa --group-directories-first -a" \
    ll="exa --group-directories-first -la"
else
  alias \
    ls='ls --color=auto' \
    ll='ls -l --color=auto' \
    la='ls -A --color=auto' \
    l='ls -CF --color=auto'
fi

# Verbosity/interactivity
alias \
  cp="cp -iv" \
  mv="mv -iv" \
  mkd="mkdir -pv"
# rm: -I is GNU only (prompts once for >3 files), BSD/macOS only has -i
if [ "$(uname -s)" = "Darwin" ]; then
  alias rm="rm -v"
else
  alias rm="rm -vI"
fi

# Prettify
alias \
  grep="grep --color=auto" \
  diff="diff --color=auto"

# Abbreviations
alias \
  sdn="sudo shutdown -h now" \
  ka="killall" \
  g="git" \
  gs="git status" \
  gd="git diff" \
  ga="git add" \
  gc="git commit" \
  e='"$EDITOR"' \
  v='"$EDITOR"'

# kitty sets TERM=xterm-kitty, which most remote hosts have no terminfo for.
# kitten ssh copies it over on connect (into the remote's ~/.terminfo, so no
# root needed). Guarded: outside kitty, or without the kitten, use plain ssh.
if [ -n "$KITTY_WINDOW_ID" ] && command -v kitten >/dev/null 2>&1; then
  alias ssh="kitten ssh"
fi

# Personal wiki: edit / sync / pull / push
wiki() {
  local wiki_dir="$HOME/Documents/wiki"
  case "$1" in
    sync|pull|push)
      if [ ! -d "$wiki_dir/.git" ]; then
        echo "wiki: $wiki_dir is not a git repo" >&2
        return 1
      fi
      if ! git -C "$wiki_dir" remote get-url origin >/dev/null 2>&1; then
        echo "wiki: no 'origin' remote configured" >&2
        return 1
      fi
      ;;
  esac
  case "$1" in
    sync)
      ( cd "$wiki_dir" || exit 1
        if ! git pull --rebase --autostash; then
          echo "wiki: pull failed (cd $wiki_dir to resolve)" >&2
          exit 1
        fi
        if [ -n "$(git status --porcelain)" ]; then
          git add -A
          git commit -m "wiki: ${2:-update $(date +%Y-%m-%d)}"
          git push
        fi )
      ;;
    pull)
      ( cd "$wiki_dir" || exit 1
        if ! git pull --rebase --autostash; then
          echo "wiki: pull failed (cd $wiki_dir to resolve)" >&2
          exit 1
        fi )
      ;;
    push)
      ( cd "$wiki_dir" || exit 1
        if [ -n "$(git status --porcelain)" ]; then
          git add -A
          git commit -m "wiki: ${2:-update $(date +%Y-%m-%d)}"
          git push
        fi )
      ;;
    "")   "$EDITOR" "$wiki_dir/index.md" ;;
    *)    echo "usage: wiki [sync|pull|push|<msg>]" ;;
  esac
}

# mkenv [name] - this project's Python environment, however this machine does
# environments. Same command everywhere:
#   cluster ($CC_CLUSTER): module + virtualenv in ~/venvs/<name>, populated
#                          from requirements.txt with the Alliance wheels
#   elsewhere:             micromamba env from environment.yml
# The name defaults to the git repository's (or directory's) name. Never share
# an environment between the two: different libc, BLAS and CUDA.
mkenv() {
  _env_name="${1:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"

  if [ -n "${CC_CLUSTER:-}" ]; then
    loadpy "$_env_name" || { unset _env_name; return 1; }
    if [ -f requirements.txt ]; then
      echo "mkenv: pip install --no-index -r requirements.txt"
      pip install --no-index -q -r requirements.txt ||
        echo "mkenv: some wheels are missing here; try avail_wheels <pkg>" >&2
    fi
  else
    if ! command -v micromamba >/dev/null 2>&1; then
      echo "mkenv: micromamba not installed on this machine" >&2
      unset _env_name
      return 1
    fi
    if micromamba env list | awk '{print $1}' | grep -qx "$_env_name"; then
      micromamba activate "$_env_name"
    elif [ -f environment.yml ]; then
      micromamba create -y -n "$_env_name" -f environment.yml &&
        micromamba activate "$_env_name"
    else
      echo "mkenv: no environment.yml here; creating a bare env" >&2
      micromamba create -y -n "$_env_name" python &&
        micromamba activate "$_env_name"
    fi
  fi

  echo "mkenv: $_env_name -> $(command -v python3 2>/dev/null || echo 'no python3')"
  unset _env_name
}
