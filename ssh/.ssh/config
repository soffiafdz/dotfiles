# Machine-local hosts (home network etc.) live outside the repo
Include config.local

Host *
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 300
    AddKeysToAgent yes
    # macOS only; IgnoreUnknown keeps this harmless on Linux
    IgnoreUnknown UseKeychain
    UseKeychain yes

# --- Digital Research Alliance of Canada ---------------------------------
# Login nodes are for editing and sbatch only; move data over the DTNs.
Host trillium trillium-gpu rorqual tri-dm1 tri-dm2 tri-dm3 tri-dm4
    User sfernand
    # One authenticated connection, reused: MFA prompts once per host, and
    # SciNet allows only 4 connections per 2 minutes.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

Host trillium
    HostName trillium.alliancecan.ca

Host trillium-gpu
    HostName trillium-gpu.alliancecan.ca

# Trillium data transfer nodes (rsync, scp, sftp)
Host tri-dm1
    HostName tri-dm1.scinet.utoronto.ca

Host tri-dm2
    HostName tri-dm2.scinet.utoronto.ca

Host tri-dm3
    HostName tri-dm3.scinet.utoronto.ca

Host tri-dm4
    HostName tri-dm4.scinet.utoronto.ca

# Rorqual: the login node doubles as its data transfer node
Host rorqual
    HostName rorqual.alliancecan.ca

