#!/bin/sh
# One-time setup on an Alliance login node. Run it after cloning the repo and
# stowing the hpc profile:
#
#     ./bootstrap -f hpc && ~/.local/bin/hpc-setup
#
# Login nodes have internet; compute nodes do not. Everything that downloads
# has to happen here. No editor is installed: the clusters ship vim, and
# ~/.vimrc runs plugin-free when $CC_CLUSTER is set.

set -eu

PREFIX="$HOME/.local"
ZSH_SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/zsh"

[ -n "${CC_CLUSTER:-}" ] || echo "warning: \$CC_CLUSTER is unset; is this a cluster?" >&2

mkdir -p "$PREFIX/bin" "$PREFIX/opt" "$ZSH_SHARE" "${XDG_CONFIG_HOME:-$HOME/.config}/hpc"

# --- Slurm account --------------------------------------------------------
acct="${XDG_CONFIG_HOME:-$HOME/.config}/hpc/account"
if [ ! -s "$acct" ]; then
	# def-<pi> shows up as a group, alongside def-<pi>_cpu and _gpu in
	# no guaranteed order. Only the unsuffixed one is a valid account.
	guess="$(id -Gn | tr ' ' '\n' | grep -m1 '^def-[^_]*$' || true)"
	if [ -n "$guess" ]; then
		echo "$guess" > "$acct"
		echo "account: $guess (edit $acct to change)"
	else
		echo "!! write your allocation into $acct, e.g. echo def-pi > $acct" >&2
	fi
fi

# --- Hand bash over to zsh ------------------------------------------------
# The clusters' login shell is bash and chsh does not work there. The stock
# ~/.bashrc sources everything in ~/.bashrc.d, so one file there is enough.
# Interactive shells only: scp, rsync, `ssh host cmd` and job scripts must
# keep their plain bash.
mkdir -p "$HOME/.bashrc.d"
handoff="$HOME/.bashrc.d/10-zsh.sh"
if [ ! -f "$handoff" ]; then
	cat > "$handoff" <<'HANDOFF'
# Start zsh for interactive shells (login shell cannot be changed here).
case $- in
*i*)
	if [ -z "${ZSH_VERSION:-}" ] && [ -t 1 ] && command -v zsh >/dev/null 2>&1; then
		exec zsh -l
	fi
	;;
esac
HANDOFF
	echo "bash handoff: $handoff"
fi

# ~/.zshenv comes from the zsh package and sets ZDOTDIR; without it zsh runs
# zsh-newuser-install and none of these dotfiles load.
if [ ! -e "$HOME/.zshenv" ]; then
	echo "!! ~/.zshenv missing: run ./bootstrap -f hpc first" >&2
fi

# --- zsh prompt and highlighting ------------------------------------------
clone() {
	if [ -d "$2/.git" ]; then
		git -C "$2" pull --quiet --ff-only || true
	else
		git clone --depth 1 "$1" "$2"
	fi
}
clone https://github.com/romkatv/powerlevel10k.git "$ZSH_SHARE/powerlevel10k"
clone https://github.com/zdharma-continuum/fast-syntax-highlighting.git \
	"$ZSH_SHARE/fast-syntax-highlighting"

# --- R personal library ---------------------------------------------------
# Version-specific, so a module upgrade does not mix compiled packages.
if command -v module >/dev/null 2>&1; then
	mkdir -p "$HOME/R"
	echo "R library root: ~/R (set R_LIBS_USER per version, or let R prompt)"
fi

cat <<'MSG'

done. Reminders:
  - log out and back in (or exec zsh -l) to pick up the hpc profile
  - the repo belongs in $HOME; only data goes in ~/projects or ~/scratch
  - pip installs only work on login nodes
  - vim runs plugin-free here; <leader>rr opens R in a tmux pane
MSG
